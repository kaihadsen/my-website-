      <article class="card">
        <img src="https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=900&q=80">

        <div class="card-content">
          <span class="category">Design</span>
          <h3>Why Simplicity Matters</h3>
          <p>The power of clean and thoughtful design.</p>
        </div>
      </article>


      <article class="card">
        <img src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=900&q=80">

        <div class="card-content">
          <span class="category">Travel</span>
          <h3>Beyond The City</h3>
          <p>Stories from roads less travelled.</p>
        </div>
      </article>

    </div>
  </section>


  <!-- PREMIUM -->
  <section class="newsletter" id="premium">

    <h2>Join NOIR Premium</h2>

    <p>
      Get exclusive stories, special editions and editorial updates.
    </p>

    <form onsubmit="subscribe(event)">

      <input
        type="email"
        placeholder="Your email address"
        required
      >

      <button type="submit">
        JOIN NOW
      </button>

    </form>

  </section>


  <!-- ABOUT -->
  <section id="about">

    <div class="section-title">
      <h2>About NOIR</h2>
      <span>EST. 2026</span>
    </div>

    <p style="max-width:750px;color:#aaa;">
      NOIR is a modern digital magazine inspired by classic editorial
      design. Our goal is to present interesting stories with a clean,
