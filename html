    </p>

  </section>


  <!-- FOOTER -->
  <footer>

    <div class="footer-logo">NOIR<span style="color:#d71920;">.</span></div>

    <p>
      © 2026 NOIR Magazine. All rights reserved.
    </p>

  </footer>


  <script>
    function subscribe(event) {
      event.preventDefault();

      alert("Thank you for joining NOIR Premium!");

      event.target.reset();
    }
  </script>

</body>
</html>